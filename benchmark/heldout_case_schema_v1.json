{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reasoning Engine Held-Out Validation v1 Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "domain",
    "routing_stratum",
    "turns",
    "evaluator_key",
    "design_metadata"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^HV1-[A-Z0-9_-]+$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "routing_stratum": {
      "enum": ["TEST", "ENGINEER", "BOTH", "NONE"]
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn", "agent_input"],
        "properties": {
          "turn": {"type": "integer", "minimum": 1},
          "agent_input": {"type": "string", "minLength": 1},
          "expected_revision": {"type": ["string", "null"]}
        }
      }
    },
    "evaluator_key": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observations", "constraints", "scoring_notes"],
      "properties": {
        "observations": {"type": "array", "items": {"type": "string"}},
        "not_observed": {"type": "array", "items": {"type": "string"}},
        "plausible_hypotheses": {"type": "array", "items": {"type": "string"}},
        "discriminating_evidence": {"type": "array", "items": {"type": "string"}},
        "decision_critical_uncertainties": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "acceptable_interventions": {"type": "array", "items": {"type": "string"}},
        "scoring_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "design_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequential", "has_distractors", "requires_action", "freshness_attestation"],
      "properties": {
        "sequential": {"type": "boolean"},
        "has_distractors": {"type": "boolean"},
        "requires_action": {"type": "boolean"},
        "freshness_attestation": {
          "const": "Not reused, paraphrased, or structurally cloned from v0.5-v0.11 development cases."
        }
      }
    }
  }
}
